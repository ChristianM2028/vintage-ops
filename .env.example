FLASK_SECRET_KEY=replace-with-a-long-random-value
TOKEN_ENCRYPTION_KEY=generate-with-fernet-generate-key
DATABASE_PATH=instance/vintage_ops.sqlite3
MARKETPLACE_MOCK_MODE=true
UPLOAD_DIRECTORY=instance/uploads
MAX_UPLOAD_SIZE=8388608
PERMITTED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp
MAX_PHOTO_COUNT=10
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_CALLBACK_URL=http://127.0.0.1:5000/ebay/callback
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_CATEGORY_ID=
EBAY_ENVIRONMENT=sandbox
EBAY_IMAGE_UPLOAD_API=media
EBAY_TIMEOUT_SECONDS=15
EBAY_METADATA_CACHE_SECONDS=86400
SELLER_USERNAME=seller
# Paste the complete Werkzeug value (including scrypt: and every $ section).
# The app loads .env itself; do not `source .env` because shells expand `$`.
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('replace-me'))"
SELLER_PASSWORD_HASH=
SESSION_COOKIE_SECURE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://127.0.0.1:5000/shop/order/{ORDER_ID}/success
STRIPE_CANCEL_URL=http://127.0.0.1:5000/shop/order/{ORDER_ID}/cancel
STRIPE_FAKE_MODE=true
STRIPE_SHIPPING_COUNTRIES=US
STOREFRONT_RESERVATION_SECONDS=1800
# Non-secret display name printed on seller packing slips.
BUSINESS_NAME=Vintage Ops
# Non-secret return address printed on seller packing slips. Use a single line or
# a quoted, application-compatible multiline value; do not put private secrets here.
BUSINESS_ADDRESS=
